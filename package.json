{
  "name": "huntd-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:debug": "node --inspect-brk node_modules/.bin/playwright test --project=chromium",
    "ci": "npx playwright install && npm ci",
    "lint": "eslint --ext .ts src || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.35.0",
    "typescript": "^5.5.0",
    "eslint": "^8.50.0",
    "@types/node": "^20.4.0"
  }
}
